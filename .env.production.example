# ===== 生产环境变量模板 =====
# 用法：在服务器上复制本文件为 .env，并填入真实值：
#   cp .env.production.example .env
#   vim .env
#
# 注意：
#  - NEXT_PUBLIC_AMAP_JS_KEY / NEXT_PUBLIC_AMAP_JS_SECURITY 是构建期内联变量，
#    docker compose 在 build 阶段通过 build-arg 读取这两个值，必须填对。
#  - DEEPSEEK_API_KEY / AMAP_KEY 是运行时服务端变量，由容器 env_file 注入。
#  - 本文件仅作占位模板，请勿提交真实 Key；真实值填在你的 .env / .env.local。

# 服务端（运行时）：DeepSeek 大模型 Key（不填则自动进入“预览模式”，用高德真实 POI 拼行程）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 服务端（运行时）：高德 Web 服务 Key（POI 搜索 / 路线规划）
AMAP_KEY=your_amap_web_service_key_here

# 前端（构建期内联）：高德 JS 地图 Key（MapView 加载地图）
NEXT_PUBLIC_AMAP_JS_KEY=your_amap_js_key_here

# 前端（构建期内联，可选）：高德 JS API 2.0 安全密钥（控制台“安全密钥”）
NEXT_PUBLIC_AMAP_JS_SECURITY=
