# DeepSeek（复用 jarvis 同款 Key）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# 高德开放平台
# Web 服务（POI 搜索 / 路线规划）：https://lbs.amap.com/api/webservice/guide/api/weather
AMAP_KEY=
# 前端 JS 地图（Web端 JS API v2.0）：https://lbs.amap.com/api/javascript-api-v2/guide/abc/prepare
NEXT_PUBLIC_AMAP_JS_KEY=
# 若浏览器地图报 INVALID_USER_SCODE / 错误码 10008，需在高德控制台复制该 JS Key 的“安全密钥”填这里
NEXT_PUBLIC_AMAP_JS_SECURITY=
